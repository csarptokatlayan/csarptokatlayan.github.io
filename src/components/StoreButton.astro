---
import { pick, useTranslations, type Locale } from '../i18n';

interface Props {
  store: 'google-play' | 'app-store' | 'steam' | 'itch' | 'epic' | 'web' | 'other';
  url: string;
  label?: string | Record<string, string>;
  locale: Locale;
}
const { store, url, label, locale } = Astro.props;
const t = useTranslations(locale);
const name = label ? pick(label, locale) : t.stores[store];
const lead = store === 'web' ? undefined : store === 'app-store' ? t.game.download : t.game.get;
---

<a class="g-btn store" href={url} rel="noopener" target="_blank">
  {
    store === 'app-store' && (
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M16.37 12.6c-.02-2.1 1.72-3.12 1.8-3.17-.98-1.43-2.5-1.63-3.05-1.65-1.3-.13-2.53.76-3.19.76-.66 0-1.67-.74-2.75-.72-1.41.02-2.72.82-3.45 2.09-1.47 2.55-.38 6.33 1.06 8.4.7 1.01 1.53 2.15 2.62 2.11 1.05-.04 1.45-.68 2.72-.68 1.27 0 1.63.68 2.74.66 1.13-.02 1.85-1.03 2.54-2.05.8-1.17 1.13-2.3 1.15-2.36-.03-.01-2.2-.85-2.22-3.36ZM14.3 6.43c.58-.7.97-1.68.86-2.65-.83.03-1.84.55-2.44 1.25-.53.62-1 1.62-.88 2.57.93.07 1.88-.47 2.46-1.17Z" />
      </svg>
    )
  }
  {
    store === 'google-play' && (
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M5 3.6v16.8a1.1 1.1 0 0 0 1.66.95l14.1-8.4a1.1 1.1 0 0 0 0-1.9L6.66 2.65A1.1 1.1 0 0 0 5 3.6Z" />
      </svg>
    )
  }
  <span class="store__text">
    {lead && <small>{lead}</small>}
    <strong>{name}</strong>
  </span>
</a>
