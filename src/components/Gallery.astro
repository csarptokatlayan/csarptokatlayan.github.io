---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fill, useTranslations, type Locale } from '../i18n';

interface Props {
  shots: { src: ImageMetadata; alt: string }[];
  locale: Locale;
}
const { shots, locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="gallery" data-gallery>
  <ul class="gallery__strip">
    {
      shots.map((shot, i) => (
        <li>
          <button
            type="button"
            class="gallery__thumb"
            data-index={i}
            aria-label={fill(t.game.openScreenshot, { n: i + 1, total: shots.length })}
          >
            <Image src={shot.src} alt={shot.alt} widths={[480, 800]} sizes="(max-width: 720px) 82vw, 40vw" loading="lazy" />
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="viewer" aria-label={t.game.screenshots}>
    <div class="viewer__frame">
      {
        shots.map((shot, i) => (
          <figure data-slide={i} hidden>
            <Image src={shot.src} alt={shot.alt} widths={[1200, 1920]} sizes="92vw" loading="lazy" />
            <figcaption>{shot.alt}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="viewer__bar">
      <button type="button" class="g-btn g-btn--quiet" data-step="-1">← {t.game.previous}</button>
      <span class="viewer__count" aria-live="polite"></span>
      <button type="button" class="g-btn g-btn--quiet" data-step="1">{t.game.next} →</button>
      <button type="button" class="g-btn" data-close>{t.game.close}</button>
    </div>
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = root.querySelector('dialog')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const count = root.querySelector('.viewer__count')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, n) => (s.hidden = n !== current));
      count.textContent = `${current + 1} / ${slides.length}`;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-index]').forEach((b) =>
      b.addEventListener('click', () => {
        show(Number(b.dataset.index));
        dialog.showModal();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(current + Number(b.dataset.step))),
    );
    root.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
  }
</script>

<style>
  .gallery__strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 520px);
    gap: clamp(0.9rem, 2vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    list-style: none;
    padding: 0 0 calc(var(--g-depth) + 1.25rem);
    scrollbar-color: var(--g-muted) transparent;
  }
  .gallery__strip li { scroll-snap-align: start; }
  .gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 4px solid var(--g-surface);
    border-radius: var(--g-radius);
    overflow: hidden;
    background: var(--g-surface);
    box-shadow: 0 var(--g-depth) 0 color-mix(in srgb, var(--g-text) 18%, transparent);
    cursor: zoom-in;
    transition: transform 0.25s var(--ease-out);
  }
  .gallery__thumb :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--g-radius) - 4px);
  }
  .gallery__thumb:hover { transform: translateY(-3px); }

  .viewer {
    width: min(96vw, 1400px);
    max-width: none;
    max-height: 96dvh;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    font-family: var(--g-body);
  }
  .viewer::backdrop { background: rgb(10 12 18 / 0.88); }
  .viewer__frame figure { display: grid; gap: 0.6rem; }
  .viewer__frame :global(img) {
    width: 100%;
    max-height: 78dvh;
    object-fit: contain;
    border-radius: var(--g-radius);
  }
  .viewer__frame figcaption { font-size: 0.95rem; opacity: 0.85; }
  .viewer__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    flex-wrap: wrap;
  }
  .viewer__count { margin-inline: auto; font-variant-numeric: tabular-nums; }
</style>
